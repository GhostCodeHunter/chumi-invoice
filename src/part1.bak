<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chumi Invoice</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Hanken+Grotesk:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400..700&family=Spline+Sans+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* Layout idea: a duplicate invoice book. Bone desk, white sheets, carbon-blue ink, one red stamp. */
:root{
  --bg:#F2F3EE; --surface:#FFFFFF; --surface-2:#F7F8F4; --ink:#0F1720; --ink-2:#4B5663; --ink-3:#6B7683;
  --line:#DADDD3; --accent:#2237E8; --accent-ink:#FFFFFF; --accent-soft:#E4E8FF; --focus:#2237E8;
  --stamp:#C93A28; --ok:#1B7F4B; --warn:#9A5B00; --warn-bg:#FFF3D6;
  --band-bg:#0F1720; --band-fg:#F2F3EE;
  --font-display:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;
  --font-body:'Hanken Grotesk',system-ui,-apple-system,'Segoe UI',sans-serif;
  --font-mono:'Spline Sans Mono',ui-monospace,'SF Mono',Menlo,Consolas,monospace;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0C1015; --surface:#141A22; --surface-2:#1A212B; --ink:#ECEFF3; --ink-2:#A9B3BF; --ink-3:#8590A0;
    --line:#2A333F; --accent:#8C99FF; --accent-ink:#0C1015; --accent-soft:#1E2547; --focus:#8C99FF;
    --stamp:#FF7A68; --ok:#58C98C; --warn:#F2B84B; --warn-bg:#3A2D12;
    --band-bg:#ECEFF3; --band-fg:#0C1015; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0C1015; --surface:#141A22; --surface-2:#1A212B; --ink:#ECEFF3; --ink-2:#A9B3BF; --ink-3:#8590A0;
  --line:#2A333F; --accent:#8C99FF; --accent-ink:#0C1015; --accent-soft:#1E2547; --focus:#8C99FF;
  --stamp:#FF7A68; --ok:#58C98C; --warn:#F2B84B; --warn-bg:#3A2D12;
  --band-bg:#ECEFF3; --band-fg:#0C1015; color-scheme:dark;
}

*,*::before,*::after{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:400 16px/1.5 var(--font-body);-webkit-font-smoothing:antialiased;min-height:100%;overflow-x:hidden;overflow-x:clip}
[hidden]{display:none!important}
a{color:inherit}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}
.ic{width:18px;height:18px;flex:none}

/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 18px;border-radius:10px;border:1px solid transparent;font-weight:600;font-size:15px;text-decoration:none;cursor:pointer;white-space:nowrap;background:none;transition:background .15s,border-color .15s,transform .15s}
.btn:active{transform:translateY(1px)}
.btn[disabled]{opacity:.55;cursor:progress}
.btn-primary{background:var(--accent);color:var(--accent-ink)}
.btn-primary:hover{filter:brightness(1.08)}
.btn-ghost{border-color:var(--ink);color:var(--ink)}
.btn-ghost:hover{background:var(--surface)}
.btn-quiet{border-color:var(--line);background:var(--surface);color:var(--ink)}
.btn-quiet:hover{border-color:var(--ink-3)}
.btn-lg{height:54px;padding:0 24px;font-size:16px;border-radius:999px}
.btn-sm{height:38px;padding:0 14px;font-size:14px}
.btn-block{width:100%}
.iconbtn{width:36px;height:36px;display:inline-grid;place-items:center;border:0;border-radius:8px;background:none;cursor:pointer;color:var(--ink-2)}
.iconbtn:hover{background:var(--surface-2);color:var(--ink)}
.iconbtn[disabled]{opacity:.35;cursor:default}
.link{font-weight:600;color:var(--accent);text-decoration:none;border-bottom:1px solid currentColor}
.link:hover{border-bottom-width:2px}

/* ---------- header ---------- */
.top{position:sticky;top:0;z-index:30;background:var(--bg);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:24px;min-height:64px}
.logo{font:800 24px/1 var(--font-display);letter-spacing:-.04em;text-decoration:none}
.logo i{font-style:normal;color:var(--accent)}
.nav{display:flex;gap:4px;margin-right:auto}
.nav a{padding:8px 12px;border-radius:8px;text-decoration:none;font-weight:500;font-size:15px;color:var(--ink-2)}
.nav a:hover{color:var(--ink);background:var(--surface)}
.nav a[aria-current="page"]{color:var(--ink);background:var(--surface);box-shadow:inset 0 -2px 0 var(--accent)}
.bar-end{display:flex;align-items:center;gap:14px}
.saved{font:500 12px var(--font-mono);color:var(--ink-3);display:flex;align-items:center;gap:6px}
.saved::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--ok)}
.saved.bad::before{background:var(--stamp)}
body[data-route="home"] .nav-app,body[data-route="home"] .saved{display:none}
body:not([data-route="home"]) .nav-home,body:not([data-route="home"]) .cta-open{display:none}

/* ---------- landing ---------- */
.eyebrow{margin:0;font:600 12px/1.2 var(--font-mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2)}
.hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:56px;align-items:center;padding-top:56px;padding-bottom:88px;overflow:hidden}
.hero h1{margin:18px 0 24px;font:800 clamp(46px,7.4vw,100px)/.94 var(--font-display);letter-spacing:-.05em;text-wrap:balance}
.hero h1 mark{color:inherit;background:linear-gradient(transparent 62%,var(--accent-soft) 62%);padding:0 .06em}
.lede{max-width:46ch;margin:0 0 28px;font-size:19px;color:var(--ink-2)}
.cta-row{display:flex;flex-wrap:wrap;gap:12px}
.fine{margin:18px 0 0;font:500 13px var(--font-mono);color:var(--ink-3)}
.book{position:relative;width:100%;max-width:460px;margin-inline:auto;justify-self:center}
.book::before,.book::after{content:"";position:absolute;inset:0;border:1px solid var(--line);border-radius:4px}
.book::before{background:var(--surface);transform:rotate(-3.2deg) translate(-10px,10px)}
.book::after{background:var(--accent-soft);transform:rotate(2.6deg) translate(12px,6px)}
.sheet-host{position:relative;overflow:hidden;background:#fff;width:100%}
.book .sheet-host{z-index:1;border:1px solid var(--line);border-radius:4px;box-shadow:0 22px 44px -22px rgba(15,23,32,.45);animation:rise .6s cubic-bezier(.2,.8,.2,1)}
.scaler{width:794px;transform-origin:0 0}
.ready{position:absolute;z-index:2;top:-16px;right:-12px;display:flex;align-items:center;gap:6px;padding:9px 13px;border-radius:4px;background:var(--accent);color:var(--accent-ink);font:600 12px/1 var(--font-mono);letter-spacing:.08em;text-transform:uppercase;transform:rotate(8deg);animation:thunk .45s cubic-bezier(.2,.8,.2,1)}
@keyframes rise{from{transform:translateY(14px)}}
@keyframes thunk{0%{opacity:0;transform:rotate(8deg) scale(1.7)}60%{opacity:1;transform:rotate(8deg) scale(.95)}100%{opacity:1;transform:rotate(8deg) scale(1)}}

.hero>*,.ed>*,.xt>*,.xband>*,.feat>*,.steps>*{min-width:0}
.sec{padding:80px 0;border-top:1px solid var(--line)}
.sec h2{margin:12px 0 0;max-width:18ch;font:700 clamp(32px,4.6vw,56px)/1 var(--font-display);letter-spacing:-.04em;text-wrap:balance}
.steps{list-style:none;margin:44px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:16px;background:var(--surface);overflow:hidden}
.steps li{padding:28px;display:flex;flex-direction:column;gap:12px;align-items:flex-start}
.steps li+li{border-left:1px solid var(--line)}
.steps .n{font:500 14px var(--font-mono);color:var(--accent)}
.steps h3{margin:0;font:700 24px/1.1 var(--font-display);letter-spacing:-.03em}
.steps p{margin:0 0 8px;color:var(--ink-2);max-width:34ch}
.steps .link{margin-top:auto}
.feat{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:44px}
.fx{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:26px;display:grid;gap:18px;align-content:start}
.fx h3{margin:0;font:700 22px/1.1 var(--font-display);letter-spacing:-.03em}
.fx p{margin:6px 0 0;color:var(--ink-2)}
.fx-vis{display:flex;gap:12px;align-items:flex-start;min-height:120px}
.mini{width:92px;height:124px;flex:none;overflow:hidden;border:1px solid var(--line);border-radius:3px;background:#fff;position:relative;box-shadow:0 8px 16px -10px rgba(15,23,32,.4)}
.mini:nth-child(2){transform:translateY(10px)}
.calc{width:100%;font:500 14px var(--font-mono);display:grid;gap:6px}
.calc div{display:flex;justify-content:space-between;gap:16px}
.calc div:last-child{border-top:2px solid var(--ink);padding-top:8px;margin-top:2px;font-weight:600}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{padding:6px 12px;border:1px solid var(--line);border-radius:999px;font-size:14px;background:var(--surface-2)}
.pdfmark{display:grid;place-items:center;width:84px;height:110px;border:1px solid var(--line);background:#fff;color:#111;border-radius:3px;font:600 13px var(--font-mono);position:relative;box-shadow:0 8px 16px -10px rgba(15,23,32,.4)}
.pdfmark::after{content:"A4";position:absolute;bottom:8px;right:8px;font-size:10px;color:#6b7683}
.xband{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;background:var(--band-bg);color:var(--band-fg);border-radius:24px;padding:48px}
.xband h2{max-width:14ch;margin:12px 0 16px}
.xband p{margin:0 0 24px;max-width:42ch;opacity:.82;font-size:18px}
.xband .eyebrow{color:inherit;opacity:.7}
.xband .btn-primary{background:var(--band-fg);color:var(--band-bg)}
.xcalc{background:var(--surface);color:var(--ink);border-radius:14px;padding:22px;display:grid;gap:14px}
.xcalc .row{display:flex;justify-content:space-between;gap:16px;font:500 14px var(--font-mono)}
.xcalc .row.big{border-top:2px solid var(--ink);padding-top:12px;font-size:18px;font-weight:600}
.xcalc .cap{font:600 11px var(--font-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3)}
.foot{padding:36px 0 48px;border-top:1px solid var(--line);color:var(--ink-3);font-size:14px}
.foot .wrap{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center}

/* ---------- editor ---------- */
.ed{display:grid;grid-template-columns:minmax(0,580px) minmax(0,1fr);gap:32px;align-items:start;padding:24px 0 72px}
.sample-note{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin:20px 0 0;padding:12px 16px;border:1px solid var(--line);border-radius:12px;background:var(--surface);font-size:14px;color:var(--ink-2)}
.sample-note button{border:0;background:none;padding:0;font-weight:600;color:var(--accent);cursor:pointer;text-decoration:underline}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:20px}
.tab{display:flex;align-items:center;gap:8px;padding:12px 14px;border:0;background:none;cursor:pointer;font-weight:600;color:var(--ink-2);border-bottom:3px solid transparent;margin-bottom:-1px}
.tab span{font:500 12px var(--font-mono);color:var(--ink-3)}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.tab[aria-selected="true"] span{color:var(--accent)}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;margin-bottom:16px}
.card h3{margin:0 0 16px;font:700 17px/1.2 var(--font-display);letter-spacing:-.02em}
.card h3 small{font:400 13px var(--font-body);color:var(--ink-3);letter-spacing:0;margin-left:8px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.stack{display:grid;gap:14px}
.span2{grid-column:1/-1}
.f{display:flex;flex-direction:column;gap:6px;min-width:0}
.f>label,.f>.lab{font-weight:600;font-size:13px;color:var(--ink-2)}
.f .hint{font-size:12px;color:var(--ink-3)}
.f .warn{font-size:12px;color:var(--warn);background:var(--warn-bg);padding:4px 8px;border-radius:6px}
input[type="text"],input[type="email"],input[type="date"],input[type="number"],select,textarea{width:100%;height:44px;padding:0 12px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);font-size:15px}
textarea{height:auto;min-height:44px;padding:10px 12px;line-height:1.45;resize:vertical}
input:hover,select:hover,textarea:hover{border-color:var(--ink-3)}
input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--focus);outline-offset:0;border-color:var(--focus)}
input.num{font-family:var(--font-mono);text-align:right;font-size:14px}
.check{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--ink-2);cursor:pointer}
.check input{width:18px;height:18px;accent-color:var(--accent)}
.nextrow{display:flex;justify-content:space-between;gap:12px;margin-top:4px}

.it{display:grid;grid-template-columns:minmax(0,1fr) 62px 88px 92px 100px;gap:8px;align-items:start;padding:10px 0;border-top:1px solid var(--line)}
.it-head{border-top:0;padding:0 0 6px;font:600 11px var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3)}
.it-head span:nth-child(4){text-align:right;padding-right:4px}
.it textarea{min-height:44px;height:44px;resize:none;overflow:hidden}
.it output{display:flex;align-items:center;justify-content:flex-end;height:44px;padding-right:4px;font:500 14px var(--font-mono)}
.it-x{display:flex;align-items:center;height:44px}
.it-x .iconbtn{width:32px;height:36px}
.it-lab{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
#itemList{margin-bottom:8px}

.readout{display:grid;gap:6px;margin-top:6px;padding:14px;border-radius:10px;background:var(--surface-2);font:500 14px var(--font-mono)}
.readout div{display:flex;justify-content:space-between;gap:16px}
.readout div.big{border-top:1px solid var(--line);padding-top:8px;margin-top:2px;font-weight:600;font-size:15px}

.laygrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:12px}
.lay{display:grid;gap:8px;padding:8px;border:2px solid var(--line);border-radius:10px;background:var(--surface-2);cursor:pointer;text-align:center;font-size:13px;font-weight:600}
.lay:hover{border-color:var(--ink-3)}
.lay[aria-checked="true"]{border-color:var(--accent);background:var(--accent-soft)}
.lay .thumb{width:100%;height:146px;overflow:hidden;background:#fff;border:1px solid var(--line);position:relative;border-radius:2px}
.swatches{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.sw{width:36px;height:36px;border-radius:50%;border:3px solid var(--surface);box-shadow:0 0 0 1px var(--line);cursor:pointer;padding:0}
.sw[aria-checked="true"]{box-shadow:0 0 0 2px var(--ink)}
.colorpick{display:flex;align-items:center;gap:10px}
.colorpick input[type="color"]{width:44px;height:44px;padding:2px;border:1px solid var(--line);border-radius:8px;background:var(--surface);cursor:pointer}
.logoline{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
.logoline img{max-height:48px;max-width:140px;border:1px solid var(--line);border-radius:6px;padding:4px;background:#fff}
.filebtn{position:relative;overflow:hidden}
.filebtn input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.filebtn:focus-within{outline:2px solid var(--focus);outline-offset:2px}

.ed-pre{position:sticky;top:84px}
.pre-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font:600 12px var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3)}
.desk{background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:20px}
.desk .sheet-host{box-shadow:0 14px 30px -18px rgba(15,23,32,.5);border:1px solid var(--line)}
.mseg{display:none}

.sendbox{display:grid;gap:12px}
.filename{font:500 13px var(--font-mono);color:var(--ink-3)}
.sendbox .btn{justify-content:flex-start}
.note{font-size:14px;color:var(--ink-2);margin:0}

/* ---------- exact total ---------- */
.xt{display:grid;grid-template-columns:minmax(0,560px) minmax(0,1fr);gap:32px;align-items:start;padding:28px 0 72px}
.page-title{margin:28px 0 0;font:800 clamp(34px,5vw,56px)/1 var(--font-display);letter-spacing:-.045em;text-wrap:balance}
.page-sub{margin:10px 0 0;max-width:60ch;color:var(--ink-2)}
.seg{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.seg label{display:flex;align-items:center;justify-content:center;text-align:center;padding:10px 12px;font-size:14px;font-weight:600;cursor:pointer;color:var(--ink-2);background:var(--surface)}
.seg label+label{border-left:1px solid var(--line)}
.seg input{position:absolute;opacity:0;pointer-events:none}
.seg input:checked+span{color:var(--accent)}
.seg label:has(input:checked){background:var(--accent-soft);color:var(--accent)}
.seg label:has(input:focus-visible){outline:2px solid var(--focus);outline-offset:-2px}
.xr{display:grid;grid-template-columns:minmax(0,1fr) 88px 110px 40px;gap:8px;align-items:start;padding:10px 0;border-top:1px solid var(--line)}
.xr-head{border-top:0;padding:0 0 6px;font:600 11px var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3)}
.xr textarea{min-height:44px;height:44px;resize:none;overflow:hidden}
.xr-x{height:44px;display:flex;align-items:center}
.result{position:sticky;top:84px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px;display:grid;gap:16px}
.result h3{margin:0;font:700 17px var(--font-display);letter-spacing:-.02em}
.rt{width:100%;border-collapse:collapse;font-size:14px}
.rt td{padding:9px 0;border-bottom:1px solid var(--line);vertical-align:top}
.rt td:last-child{text-align:right;font-family:var(--font-mono);white-space:nowrap;padding-left:16px}
.rt tr.sum td{border-bottom:0;color:var(--ink-2)}
.rt tr.tot td{border-top:2px solid var(--ink);border-bottom:0;font-weight:700;font-size:17px;color:var(--ink);padding-top:12px}
.status{display:flex;gap:10px;align-items:flex-start;padding:12px 14px;border-radius:10px;font-size:14px}
.status.ok{background:color-mix(in srgb,var(--ok) 14%,var(--surface));color:var(--ink)}
.status.ok svg{color:var(--ok)}
.status.bad{background:var(--warn-bg);color:var(--ink)}
.status.bad svg{color:var(--warn)}

.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);z-index:60;display:flex;align-items:center;gap:14px;max-width:calc(100% - 32px);padding:12px 16px;border-radius:10px;background:var(--ink);color:var(--bg);font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s}
.toast.on{opacity:1;transform:translate(-50%,0);pointer-events:auto}
.toast button{border:0;background:none;color:inherit;font-weight:700;text-decoration:underline;cursor:pointer;padding:0}

/* ---------- the paper (a document: fixed colors, never themed) ---------- */
.paper{--ph:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;--pb:'Hanken Grotesk','Segoe UI',system-ui,sans-serif;--pn:var(--pb);
  width:794px;min-height:1123px;box-sizing:border-box;background:#fff;color:#171a1f;padding:56px;display:flex;flex-direction:column;position:relative;text-align:left;
  font-family:var(--pb);font-size:13px;line-height:1.5;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.paper[data-font="serif"]{--ph:'Newsreader',Georgia,'Times New Roman',serif;--pb:'Newsreader',Georgia,'Times New Roman',serif;font-size:14.5px}
.paper[data-font="mix"]{--ph:'Newsreader',Georgia,'Times New Roman',serif}
.paper[data-font="mono"]{--ph:'Spline Sans Mono',ui-monospace,Menlo,Consolas,monospace;--pb:'Spline Sans Mono',ui-monospace,Menlo,Consolas,monospace;font-size:12px}
.paper[data-font="display"]{--pb:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif}
.paper *{box-sizing:border-box}
.p-head{display:flex;justify-content:space-between;align-items:flex-start;gap:32px;margin-bottom:40px}
.p-brand{display:flex;align-items:center;gap:14px;min-width:0}
.p-logo{max-height:56px;max-width:140px;object-fit:contain;display:block}
.p-bizname{font-family:var(--ph);font-weight:700;font-size:18px;line-height:1.2;color:#111}
.p-small{font-size:12px;line-height:1.55;color:#5a626d;margin-top:4px}
.p-title{text-align:right}
.p-title h1{margin:0;font-family:var(--ph);font-weight:700;font-size:30px;line-height:1;letter-spacing:.08em;text-transform:uppercase;color:var(--a)}
.p-num{margin-top:8px;font-family:var(--pn);font-size:13px;color:#5a626d}
.paper[data-head="center"] .p-head{flex-direction:column-reverse;align-items:center;text-align:center;gap:20px;padding-bottom:28px;border-bottom:1px solid #d6d9de}
.paper[data-head="center"] .p-brand{flex-direction:column;gap:8px}
.paper[data-head="center"] .p-title{text-align:center}
.paper[data-head="band"] .p-head{margin:-56px -56px 40px;padding:44px 56px;background:var(--a)}
.paper[data-head="band"] .p-bizname,.paper[data-head="band"] .p-title h1{color:var(--a-ink)}
.paper[data-head="band"] .p-small,.paper[data-head="band"] .p-num{color:var(--a-ink);opacity:.85}
.paper[data-head="rail"]{border-left:20px solid var(--a);padding-left:40px}
.paper[data-head="stack"] .p-head{flex-direction:column-reverse;gap:26px;padding-bottom:26px;border-bottom:4px solid #111}
.paper[data-head="stack"] .p-title{text-align:left;display:flex;align-items:baseline;justify-content:space-between;gap:18px}
.paper[data-head="stack"] .p-title h1{font-size:58px;letter-spacing:-.03em;color:#111}
.paper[data-head="stack"] .p-num{margin:0}
.p-meta{display:grid;grid-template-columns:1fr auto;gap:40px;margin-bottom:34px;position:relative}
.p-label{font-family:var(--pn);font-weight:600;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--a);margin-bottom:6px}
.p-client{font-family:var(--ph);font-weight:600;font-size:16px;line-height:1.3;color:#111}
.p-dates{margin:0;min-width:236px}
.p-dates div{display:flex;justify-content:space-between;gap:28px;padding:3px 0}
.p-dates dt{color:#5a626d}
.p-dates dd{margin:0;font-weight:600;color:#111;font-family:var(--pn);text-align:right}
.p-dates .p-due{margin-top:6px;padding-top:9px;border-top:1px solid #d6d9de}
.p-dates .p-due dd{color:var(--a);font-size:15px}
.p-items{width:100%;table-layout:fixed;border-collapse:collapse;margin-bottom:26px}
.p-items .c-q{width:56px}.p-items .c-r{width:120px}.p-items .c-a{width:134px}
.p-items th{font-family:var(--pn);font-weight:600;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;text-align:right;padding:10px;color:#5a626d}
.p-items td{padding:12px 10px;vertical-align:top;text-align:right;font-family:var(--pn);word-wrap:break-word}
.p-items th:first-child,.p-items td:first-child{text-align:left}
.p-items td:first-child{font-family:var(--pb)}
.p-items td:not(:first-child){white-space:nowrap}
.paper[data-table="rule"] .p-items th{border-bottom:2px solid #111;color:#111}
.paper[data-table="rule"] .p-items td{border-bottom:1px solid #e3e5e8}
.paper[data-table="zebra"] .p-items th{color:var(--a);border-bottom:2px solid var(--a)}
.paper[data-table="zebra"] .p-items tbody tr:nth-child(even) td{background:#f5f6f8}
.paper[data-table="grid"] .p-items th,.paper[data-table="grid"] .p-items td{border:1px solid #cfd3d9}
.paper[data-table="grid"] .p-items th{background:#f3f4f6;color:#111}
.paper[data-table="solid"] .p-items th{background:var(--a);color:var(--a-ink)}
.paper[data-table="solid"] .p-items td{border-bottom:1px solid #e3e5e8}
.paper[data-table="soft"] .p-items th{background:var(--a-soft);color:var(--a)}
.paper[data-table="soft"] .p-items td{border-bottom:1px solid #e3e5e8}
.p-bottom{display:flex;justify-content:space-between;align-items:flex-start;gap:36px;margin-bottom:24px}
.p-notes{flex:1;min-width:0}
.p-block{margin-bottom:18px;color:#3b424c}
.p-totals{width:290px;flex:none}
.p-totals .r{display:flex;justify-content:space-between;gap:20px;padding:6px 0;font-family:var(--pn);color:#171a1f}
.p-totals .r span:first-child{color:#5a626d;font-family:var(--pb)}
.p-totals .r.p-strong{font-weight:700;border-top:1px solid #d6d9de;margin-top:4px;padding-top:10px}
.p-totals .r.p-fine{font-size:12px}
.p-totals .r.p-grand{font-weight:700;font-size:16px;margin-top:8px;padding-top:12px;border-top:2px solid #111}
.p-totals .r.p-grand span:first-child{color:inherit}
.paper[data-total="box"] .p-totals .r.p-grand{background:var(--a);color:var(--a-ink);border-top:0;padding:12px 14px;border-radius:6px}
.paper[data-total="bar"] .p-totals .r.p-grand{background:var(--a-soft);color:#111;border-top:0;border-left:4px solid var(--a);padding:12px 14px}
.paper[data-total="outline"] .p-totals .r.p-grand{color:var(--a);border:2px solid var(--a);padding:11px 14px;border-radius:4px}
.p-foot{margin-top:auto;padding-top:36px;color:#5a626d;font-size:12px;text-align:center}
.p-stamp{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-10deg);border:3px solid;border-radius:6px;padding:5px 14px;font-family:var(--ph);font-weight:800;font-size:26px;line-height:1;letter-spacing:.1em;text-transform:uppercase;opacity:.85;white-space:nowrap;pointer-events:none}
.p-stamp-paid{color:#1b7f4b;border-color:#1b7f4b}
.p-stamp-overdue{color:#c93a28;border-color:#c93a28}
.p-stamp-draft{color:#7a8591;border-color:#7a8591}
.p-hint{color:#a4abb5!important;font-weight:500}
.paper[data-export] .p-hint{display:none}

/* ---------- print ---------- */
#printSheet{display:none}
@media print{
  @page{size:A4;margin:0}
  body>*:not(#printSheet){display:none!important}
  #printSheet{display:block}
  html,body{background:#fff}
  #printSheet .paper{width:210mm;min-height:297mm}
  .p-items tr,.p-totals,.p-block{break-inside:avoid}
}

/* ---------- small screens ---------- */
@media (max-width:1000px){
  .hero{grid-template-columns:minmax(0,1fr);gap:48px;padding-top:36px}
  .xband{grid-template-columns:minmax(0,1fr);padding:32px}
  .ed,.xt{grid-template-columns:minmax(0,1fr);padding-bottom:104px}
  .ed-pre{position:static}
  .result{position:static}
  .ed[data-pane="form"] .ed-pre{display:none}
  .ed[data-pane="preview"] .ed-form{display:none}
  .mseg{display:grid;grid-template-columns:1fr 1fr;position:fixed;left:16px;right:16px;bottom:16px;z-index:40;padding:4px;border-radius:14px;background:var(--ink);box-shadow:0 12px 30px -10px rgba(0,0,0,.5)}
  .mseg button{height:42px;border:0;border-radius:10px;background:none;color:var(--bg);font-weight:600;cursor:pointer}
  .mseg button[aria-pressed="true"]{background:var(--bg);color:var(--ink)}
  body:not([data-route="invoice"]) .mseg{display:none}
  .toast{bottom:84px}
}
@media (max-width:760px){
  .steps{grid-template-columns:1fr}
  .steps li+li{border-left:0;border-top:1px solid var(--line)}
  .feat{grid-template-columns:1fr}
  .nav-home{display:none}
  .sec{padding:56px 0}
  .bar{gap:12px}
}
@media (max-width:640px){
  .g2,.g3{grid-template-columns:1fr}
  .g3.keep{grid-template-columns:1fr 1fr 1fr}
  .it{grid-template-columns:1fr 1fr 1fr;grid-template-areas:"d d d" "q r a" "x x x"}
  .it-head,.xr-head{display:none}
  .it-desc{grid-area:d}.it-q{grid-area:q}.it-r{grid-area:r}.it-a{grid-area:a}.it-x{grid-area:x;justify-self:end}
  .it-lab{position:static;width:auto;height:auto;clip:auto;display:block;margin-bottom:4px;font-weight:600;font-size:12px;color:var(--ink-2)}
  .xr{grid-template-columns:1fr 1fr 40px;grid-template-areas:"d d x" "s fx fx"}
  .xr-d{grid-area:d}.xr-s{grid-area:s}.xr-f{grid-area:fx}.xr-x{grid-area:x;align-self:end}
  .xr .it-lab{display:block;position:static;width:auto;height:auto;clip:auto}
  input[type="text"],input[type="email"],input[type="date"],input[type="number"],select,textarea{font-size:16px}
  .card{padding:16px}
  .hero h1{font-size:clamp(42px,13vw,64px)}
  .tab{padding:12px 10px}
  .desk{padding:12px}
  .saved{display:none}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}
</style>
</head>
