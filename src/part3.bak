<script>
(()=>{
'use strict';
/* ---------- helpers ---------- */
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>Array.from(r.querySelectorAll(s));
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nl=s=>esc(s).replace(/\r?\n/g,'<br>');
const uid=()=>Math.random().toString(36).slice(2,9);
const KEY='chumi-invoice-v1';
const H2C='https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
const LS={get(k){try{return localStorage.getItem(k)}catch(e){return null}},set(k,v){try{localStorage.setItem(k,v);return true}catch(e){return false}}};
const isFramed=(()=>{try{return window.self!==window.top}catch(e){return true}})();

const num=v=>{const n=parseFloat(String(v==null?'':v).replace(/,/g,''));return Number.isFinite(n)?n:0};
const numStr=v=>String(+num(v).toFixed(4));
const pad=n=>String(n).padStart(2,'0');
const iso=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
const parseD=s=>{const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s||'');return m?new Date(+m[1],+m[2]-1,+m[3]):null};
const addDays=(s,n)=>{const d=parseD(s);if(!d)return '';d.setDate(d.getDate()+n);return iso(d)};
const fmtDate=s=>{const d=parseD(s);return d?d.toLocaleDateString('en-US',{month:'short',day:'2-digit',year:'numeric'}):''};
const today=()=>iso(new Date());
const bump=s=>/\d+\D*$/.test(s||'')?String(s).replace(/(\d+)(\D*)$/,(m,n,r)=>String(+n+1).padStart(n.length,'0')+r):((s||'INV')+'-2');

/* ---------- money (all maths in whole minor units) ---------- */
const CURRENCIES=[['USD','US dollar'],['EUR','Euro'],['GBP','British pound'],['AED','UAE dirham'],['INR','Indian rupee'],['SAR','Saudi riyal'],['QAR','Qatari riyal'],['KWD','Kuwaiti dinar'],['BHD','Bahraini dinar'],['OMR','Omani rial'],['CAD','Canadian dollar'],['AUD','Australian dollar'],['NZD','New Zealand dollar'],['SGD','Singapore dollar'],['CHF','Swiss franc'],['JPY','Japanese yen'],['CNY','Chinese yuan'],['ZAR','South African rand'],['MXN','Mexican peso'],['BRL','Brazilian real']];
const nfs={};
const nf=c=>nfs[c]||(nfs[c]=new Intl.NumberFormat('en-US',{style:'currency',currency:c}));
const dec=c=>nf(c).resolvedOptions().maximumFractionDigits;
const money=(v,c)=>nf(c).format((v||0)/Math.pow(10,dec(c)));
const fromMinor=(v,c)=>((v||0)/Math.pow(10,dec(c))).toFixed(dec(c));
const toMinor=(v,c)=>Math.round(+(num(v)*Math.pow(10,dec(c))).toFixed(6));
const taxOf=(base,rate)=>Math.round(+(base*rate/100).toFixed(6));

function calc(s){
  const d=dec(s.currency),m=Math.pow(10,d);
  const items=s.items.map(it=>{
    const q=num(it.qty),rateM=Math.round(+(num(it.rate)*m).toFixed(6));
    return{id:it.id,desc:it.desc||'',q,rateM,amt:Math.round(+(q*rateM).toFixed(6))};
  });
  const subtotal=items.reduce((a,i)=>a+i.amt,0);
  const dv=Math.max(num(s.discount.value),0);
  let discount=s.discount.type==='percent'?Math.round(+(subtotal*Math.min(dv,100)/100).toFixed(6)):Math.round(+(dv*m).toFixed(6));
  if(subtotal>=0)discount=Math.min(discount,subtotal);
  const taxable=subtotal-discount,rate=Math.max(num(s.tax.rate),0);
  let tax,total;
  if(s.tax.inclusive&&rate>0){tax=taxable-Math.round(+(taxable/(1+rate/100)).toFixed(6));total=taxable}
  else{tax=taxOf(taxable,rate);total=taxable+tax}
  const adj=Math.round(+(num(s.adjustment)*m).toFixed(6));
  total+=adj;
  const paid=Math.round(+(num(s.paid)*m).toFixed(6));
  return{d,m,items,subtotal,discount,taxable,tax,adj,total,paid,due:total-paid};
}

/* Find a subtotal S so that S + tax(S) equals the total T exactly. */
function solveIncl(T,rate){
  if(!(rate>0))return{S:T,tax:0,adj:0};
  const g=Math.round(T/(1+rate/100));
  for(let k=0;k<=60;k++){
    for(const S of(k?[g+k,g-k]:[g])){
      if(S>0&&S+taxOf(S,rate)===T)return{S,tax:taxOf(S,rate),adj:0};
    }
  }
  let best=null;
  for(let S=Math.max(1,g-4);S<=g+4;S++){
    const tax=taxOf(S,rate),adj=T-(S+tax);
    if(!best||Math.abs(adj)<Math.abs(best.adj))best={S,tax,adj};
  }
  return best;
}

function solveExact(xt,cur){
  const T=toMinor(xt.total,cur),rate=Math.max(num(xt.taxRate),0);
  if(!(T>0))return{err:'Enter the exact total to see your invoice lines.'};
  let S,tax,adj=0;
  if(xt.mode==='excl'){S=T;tax=taxOf(S,rate)}
  else{const r=solveIncl(T,rate);S=r.S;tax=r.tax;adj=r.adj}
  if(!xt.rows.length)return{err:'Add at least one item.'};
  const rows=xt.rows.map((r,i)=>({desc:(r.desc||'').trim()||('Item '+(i+1)),fixed:String(r.fixed||'').trim()===''?null:toMinor(r.fixed,cur),w:Math.max(num(r.share),0)}));
  const F=rows.reduce((a,r)=>a+(r.fixed||0),0);
  const flex=rows.filter(r=>r.fixed===null);
  const R=S-F;
  if(R<0)return{err:'Your fixed amounts add up to '+money(F,cur)+', which is more than the subtotal of '+money(S,cur)+'. Lower a fixed amount or raise the total.'};
  if(!flex.length&&R!==0)return{err:'Your fixed amounts leave '+money(R,cur)+' unassigned. Clear one fixed amount so that item can absorb the difference.'};
  if(flex.length){
    let W=flex.reduce((a,r)=>a+r.w,0);
    if(W===0){flex.forEach(r=>r.w=1);W=flex.length}
    flex.forEach(r=>{const raw=R*r.w/W;r.fl=Math.floor(raw);r.fr=raw-r.fl;r.amt=r.fl});
    let left=R-flex.reduce((a,r)=>a+r.fl,0);
    flex.map((r,i)=>[r,i]).sort((a,b)=>b[0].fr-a[0].fr||a[1]-b[1]).slice(0,Math.max(left,0)).forEach(([r])=>{r.amt++});
  }
  rows.forEach(r=>{if(r.fixed!==null)r.amt=r.fixed});
  return{rows,S,tax,adj,total:S+tax+adj,target:T};
}

/* ---------- state ---------- */
const item=(desc,qty,rate)=>({id:uid(),desc:desc||'',qty:String(qty==null?1:qty),rate:rate==null?'':String(rate)});
function sampleState(){
  const t=today();
  return{sample:true,title:'Invoice',number:'INV-014',issue:t,terms:'14',due:addDays(t,14),po:'',stamp:'none',
    from:{name:'Northstar Studio',email:'hello@northstar.studio',phone:'+1 555 0142',address:'18 Harbor Street\nPortland, OR 97201',taxId:''},
    to:{name:'Avery Chen',company:'Chen & Co.',email:'avery@chenco.com',address:'92 Alder Avenue\nSeattle, WA 98101',taxId:''},
    logo:'',currency:'USD',
    items:[item('Brand identity & art direction',1,2400),item('Website design, 5 pages',1,1800),item('Illustration suite',1,750)],
    discount:{type:'percent',value:''},tax:{label:'Tax',rate:'8',inclusive:false},adjustment:'',paid:'',
    notes:'Thank you for your business. Please pay within the terms shown above.',
    payment:'Bank transfer to Example Bank\nAccount name: Northstar Studio\nAccount no. 0000 0000. Please quote the invoice number.',
    footer:'Questions about this invoice? Reply to the email it came with.',
    layout:'classic',accent:'#2237E8'};
}
function blankInvoice(keep){
  const t=today(),o=keep||sampleState();
  return{sample:false,title:o.title||'Invoice',number:keep?bump(keep.number):'INV-001',issue:t,terms:o.terms||'14',due:addDays(t,o.terms==='custom'?14:(+o.terms||0)),po:'',stamp:'none',
    from:keep?{...keep.from}:{name:'',email:'',phone:'',address:'',taxId:''},
    to:{name:'',company:'',email:'',address:'',taxId:''},
    logo:keep?keep.logo:'',currency:o.currency,items:[item('',1,'')],
    discount:{type:'percent',value:''},tax:keep?{...keep.tax}:{label:'Tax',rate:'',inclusive:false},adjustment:'',paid:'',
    notes:keep?keep.notes:'',payment:keep?keep.payment:'',footer:keep?keep.footer:'',layout:o.layout,accent:o.accent};
}
const defaultTool=()=>({total:'5000',mode:'incl',taxLabel:'Tax',taxRate:'8',rows:[
  {id:uid(),desc:'Brand identity & art direction',share:'2400',fixed:''},
  {id:uid(),desc:'Website design, 5 pages',share:'1800',fixed:''},
  {id:uid(),desc:'Illustration suite',share:'750',fixed:''}]});
const isObj=v=>v&&typeof v==='object'&&!Array.isArray(v);
function merge(base,over){for(const k in over){if(isObj(base[k])&&isObj(over[k]))merge(base[k],over[k]);else base[k]=over[k]}return base}
const app={inv:null,xt:null};
const ui={tab:'details'};
function load(){
  try{
    const o=JSON.parse(LS.get(KEY)||'null');
    if(o&&o.inv){app.inv=merge(sampleState(),o.inv);app.xt=merge(defaultTool(),o.xt||{})}
  }catch(e){}
  if(!app.inv){app.inv=sampleState();app.xt=defaultTool()}
  app.inv.items.forEach(i=>{if(!i.id)i.id=uid()});
  app.xt.rows.forEach(i=>{if(!i.id)i.id=uid()});
}
function getPath(o,p){return p.split('.').reduce((a,k)=>a==null?a:a[k],o)}
function setPath(o,p,v){const k=p.split('.');let t=o;for(let i=0;i<k.length-1;i++)t=t[k[i]];t[k[k.length-1]]=v}

/* ---------- layouts ---------- */
const LAYOUTS=[
 ['classic','Classic','split','rule','mix','plain'],['modern','Modern','band','soft','sans','box'],
 ['minimal','Minimal','split','rule','sans','plain'],['bold','Bold','stack','solid','display','bar'],
 ['ledger','Ledger','center','grid','serif','outline'],['studio','Studio','rail','zebra','sans','box'],
 ['executive','Executive','band','rule','serif','bar'],['soft','Soft','split','soft','sans','outline'],
 ['mono','Mono','split','grid','mono','plain'],['editorial','Editorial','stack','rule','serif','plain'],
 ['banner','Banner','band','zebra','display','bar'],['stripe','Stripe','rail','soft','mix','plain'],
 ['receipt','Receipt','center','rule','mono','box'],['boxed','Boxed','split','grid','sans','box'],
 ['fresh','Fresh','stack','zebra','sans','outline'],['heritage','Heritage','center','solid','serif','bar']
].map(([id,name,head,table,font,total])=>({id,name,head,table,font,total}));
const SWATCHES=['#2237E8','#0F766E','#15803D','#B45309','#C2410C','#BE185D','#6D28D9','#111827'];
const hex2rgb=h=>{h=h.replace('#','');if(h.length===3)h=h.split('').map(c=>c+c).join('');const n=parseInt(h,16);return[(n>>16)&255,(n>>8)&255,n&255]};
const mix=(h,t)=>{const[r,g,b]=hex2rgb(h);const m=v=>Math.round(v*t+255*(1-t));return'rgb('+m(r)+','+m(g)+','+m(b)+')'};
const inkOn=h=>{const[r,g,b]=hex2rgb(h);return(0.2126*r+0.7152*g+0.0722*b)/255>0.62?'#111111':'#ffffff'};

/* ---------- the invoice document ---------- */
function paperHTML(s){
  const L=LAYOUTS.find(l=>l.id===s.layout)||LAYOUTS[0];
  const c=calc(s),cur=s.currency,M=v=>money(v,cur);
  const acc=/^#[0-9a-f]{6}$/i.test(s.accent)?s.accent:'#2237E8';
  const f=s.from,t=s.to;
  const join=a=>a.filter(Boolean).join('<br>');
  const fromSmall=join([f.address&&nl(f.address),f.email&&esc(f.email),f.phone&&esc(f.phone),f.taxId&&('Tax ID: '+esc(f.taxId))]);
  const toSmall=join([t.address&&nl(t.address),t.email&&esc(t.email),t.taxId&&('Tax ID: '+esc(t.taxId))]);
  const rows=c.items.filter(i=>i.desc.trim()||i.amt).map(i=>'<tr><td>'+(nl(i.desc)||'&nbsp;')+'</td><td>'+numStr(i.q)+'</td><td>'+M(i.rateM)+'</td><td>'+M(i.amt)+'</td></tr>').join('')
    ||'<tr><td><span class="p-hint">Describe your first item</span></td><td></td><td></td><td></td></tr>';
  const rate=Math.max(num(s.tax.rate),0),taxLbl=esc(s.tax.label||'Tax')+' ('+numStr(rate)+'%)';
  const tr=[];
  tr.push('<div class="r"><span>Subtotal</span><span>'+M(c.subtotal)+'</span></div>');
  if(c.discount)tr.push('<div class="r"><span>Discount'+(s.discount.type==='percent'?' ('+numStr(s.discount.value)+'%)':'')+'</span><span>-'+M(c.discount)+'</span></div>');
  if(rate>0&&!s.tax.inclusive)tr.push('<div class="r"><span>'+taxLbl+'</span><span>'+M(c.tax)+'</span></div>');
  if(c.adj)tr.push('<div class="r"><span>Rounding</span><span>'+(c.adj<0?'-':'')+M(Math.abs(c.adj))+'</span></div>');
  const paidOn=c.paid>0;
  tr.push('<div class="r '+(paidOn?'p-strong':'p-grand')+'"><span>Total</span><span>'+M(c.total)+'</span></div>');
  if(rate>0&&s.tax.inclusive)tr.push('<div class="r p-fine"><span>Includes '+taxLbl+'</span><span>'+M(c.tax)+'</span></div>');
  if(paidOn){tr.push('<div class="r"><span>Paid</span><span>-'+M(c.paid)+'</span></div>');tr.push('<div class="r p-grand"><span>Balance due</span><span>'+M(c.due)+'</span></div>')}
  const blocks=[s.payment&&'<div class="p-block"><div class="p-label">Payment details</div><div>'+nl(s.payment)+'</div></div>',s.notes&&'<div class="p-block"><div class="p-label">Notes</div><div>'+nl(s.notes)+'</div></div>'].filter(Boolean).join('');
  const stamps={paid:'Paid',overdue:'Overdue',draft:'Draft'};
  const stamp=stamps[s.stamp]?'<div class="p-stamp p-stamp-'+s.stamp+'">'+stamps[s.stamp]+'</div>':'';
  return'<div class="paper" data-head="'+L.head+'" data-table="'+L.table+'" data-font="'+L.font+'" data-total="'+L.total+'" style="--a:'+acc+';--a-soft:'+mix(acc,.1)+';--a-ink:'+inkOn(acc)+'">'
   +'<header class="p-head"><div class="p-brand">'+(s.logo?'<img class="p-logo" src="'+esc(s.logo)+'" alt="">':'')
   +'<div class="p-biz"><div class="p-bizname'+(f.name?'':' p-hint')+'">'+(f.name?esc(f.name):'Your business name')+'</div>'+(fromSmall?'<div class="p-small">'+fromSmall+'</div>':'')+'</div></div>'
   +'<div class="p-title"><h1>'+esc(s.title||'Invoice')+'</h1>'+(s.number?'<div class="p-num">No. '+esc(s.number)+'</div>':'')+'</div></header>'
   +'<section class="p-meta"><div class="p-bill"><div class="p-label">Billed to</div>'
   +'<div class="p-client'+((t.name||t.company)?'':' p-hint')+'">'+((t.name||t.company)?join([esc(t.name),esc(t.company)]):'Client name')+'</div>'+(toSmall?'<div class="p-small">'+toSmall+'</div>':'')+'</div>'
   +'<dl class="p-dates"><div><dt>Issued</dt><dd>'+(fmtDate(s.issue)||'-')+'</dd></div><div><dt>Due</dt><dd>'+(fmtDate(s.due)||'-')+'</dd></div>'
   +(s.po?'<div><dt>Reference</dt><dd>'+esc(s.po)+'</dd></div>':'')
   +'<div class="p-due"><dt>Amount due</dt><dd>'+M(c.due)+'</dd></div></dl>'+stamp+'</section>'
   +'<table class="p-items"><colgroup><col><col class="c-q"><col class="c-r"><col class="c-a"></colgroup><thead><tr><th>Description</th><th>Qty</th><th>Rate</th><th>Amount</th></tr></thead><tbody>'+rows+'</tbody></table>'
   +'<section class="p-bottom"><div class="p-notes">'+blocks+'</div><div class="p-totals">'+tr.join('')+'</div></section>'
   +'<footer class="p-foot">'+(s.footer?nl(s.footer):'')+'</footer></div>';
}

/* ---------- scaled previews ---------- */
const hosts=new Map();
function fit(host,o){
  o=o||hosts.get(host)||{};
  const sc=host.firstElementChild,paper=sc&&sc.firstElementChild,w=host.clientWidth;
  if(!paper||!w)return;
  const k=w/794;
  sc.style.transform='scale('+k+')';
  if(!o.noHeight)host.style.height=Math.ceil(paper.offsetHeight*k)+'px';
}
const ro=new ResizeObserver(es=>es.forEach(e=>fit(e.target)));
function mount(host,o){hosts.set(host,o||{});ro.observe(host);fit(host,o||{})}
const refit=()=>hosts.forEach((o,h)=>fit(h,o));

/* ---------- toast ---------- */
let toastT=0;
function toast(msg,action){
  const el=$('#toast');
  el.innerHTML='<span>'+esc(msg)+'</span>'+(action?'<button type="button">'+esc(action.label)+'</button>':'');
  if(action)$('button',el).onclick=()=>{el.classList.remove('on');action.fn()};
  el.classList.add('on');clearTimeout(toastT);
  toastT=setTimeout(()=>el.classList.remove('on'),action?7000:2800);
}

/* ---------- editor: render ---------- */
let rafId=0,saveT=0,thumbT=0;
function schedule(){
  if(!rafId)rafId=requestAnimationFrame(()=>{rafId=0;renderPreview();renderSummary();});
  clearTimeout(saveT);saveT=setTimeout(save,500);
  if(ui.tab==='design'){clearTimeout(thumbT);thumbT=setTimeout(renderThumbs,250)}
}
function save(){
  const ok=LS.set(KEY,JSON.stringify(app)),n=$('#savedNote');
  n.textContent=ok?'Saved on this device':'Not saved: browser storage is blocked';
  n.classList.toggle('bad',!ok);
}
const PAGE={h:1123,top:48,bottom:40};
function planPages(H,safe){
  if(H<=PAGE.h+2)return[[0,H,0]];
  const out=[];let y=0;
  while(y<H-2){
    const top=out.length?PAGE.top:0,cap=PAGE.h-top-PAGE.bottom;
    let end=Math.min(H,y+cap);
    if(end<H){const c=safe.filter(v=>v>y+cap*0.45&&v<=end);if(c.length)end=Math.max.apply(null,c)}
    out.push([y,end,top]);y=end;
  }
  return out;
}
function safePoints(paper,k){
  const base=paper.getBoundingClientRect().top;
  return $$('.p-head,.p-meta,.p-items tbody tr,.p-bottom',paper).map(e=>Math.ceil((e.getBoundingClientRect().bottom-base)/k));
}
function renderPreview(){
  const host=$('#prevHost');
  if(document.body.dataset.route!=='invoice')return;
  host.firstElementChild.innerHTML=paperHTML(app.inv);
  fit(host);
  const paper=host.firstElementChild.firstElementChild,k=(host.clientWidth/794)||1;
  const pages=planPages(paper.offsetHeight,safePoints(paper,k)).length;
  $('#pageCount').textContent='A4 · '+pages+(pages===1?' page':' pages');
  $('#fileName').textContent='File name: '+fileName();
}
function renderSummary(){
  const s=app.inv,c=calc(s),M=v=>money(v,s.currency),r=[];
  r.push('<div><span>Subtotal</span><span>'+M(c.subtotal)+'</span></div>');
  if(c.discount)r.push('<div><span>Discount</span><span>-'+M(c.discount)+'</span></div>');
  if(c.tax)r.push('<div><span>'+esc(s.tax.label||'Tax')+(s.tax.inclusive?' (included)':'')+'</span><span>'+M(c.tax)+'</span></div>');
  if(c.adj)r.push('<div><span>Rounding</span><span>'+M(c.adj)+'</span></div>');
  r.push('<div class="big"><span>'+(c.paid>0?'Balance due':'Total')+'</span><span>'+M(c.due)+'</span></div>');
  $('#sumReadout').innerHTML=r.join('');
  $$('[data-amt]').forEach(o=>{const i=c.items.find(x=>x.id===o.dataset.amt);o.textContent=i?M(i.amt):''});
  const w=$('#dueWarn');w.hidden=!(s.due&&s.issue&&s.due<s.issue);
}
const autogrow=el=>{el.style.height='auto';el.style.height=Math.max(44,el.scrollHeight+2)+'px'};

function itemRow(it,i,n){
  const id=it.id;
  return'<div class="it" data-id="'+id+'">'
   +'<div class="it-desc f"><label class="it-lab" for="d-'+id+'">Description</label><textarea id="d-'+id+'" rows="1" data-f="desc" autocomplete="off">'+esc(it.desc)+'</textarea></div>'
   +'<div class="it-q f"><label class="it-lab" for="q-'+id+'">Qty</label><input id="q-'+id+'" class="num" type="text" inputmode="decimal" data-f="qty" value="'+esc(it.qty)+'" autocomplete="off"></div>'
   +'<div class="it-r f"><label class="it-lab" for="r-'+id+'">Rate</label><input id="r-'+id+'" class="num" type="text" inputmode="decimal" data-f="rate" value="'+esc(it.rate)+'" autocomplete="off"></div>'
   +'<div class="it-a f"><span class="it-lab">Amount</span><output data-amt="'+id+'"></output></div>'
   +'<div class="it-x"><button type="button" class="iconbtn" data-act="up" title="Move up" aria-label="Move item up"'+(i===0?' disabled':'')+'><svg class="ic"><use href="#i-up"/></svg></button>'
   +'<button type="button" class="iconbtn" data-act="down" title="Move down" aria-label="Move item down"'+(i===n-1?' disabled':'')+'><svg class="ic"><use href="#i-down"/></svg></button>'
   +'<button type="button" class="iconbtn" data-act="del" title="Remove item" aria-label="Remove item"><svg class="ic"><use href="#i-trash"/></svg></button></div></div>';
}
function renderItems(focusId,act){
  const L=$('#itemList'),n=app.inv.items.length;
  L.innerHTML=app.inv.items.map((it,i)=>itemRow(it,i,n)).join('');
  $$('textarea',L).forEach(autogrow);
  renderSummary();
  if(focusId){const r=$('[data-id="'+focusId+'"]',L);const b=r&&(act&&$('[data-act="'+act+'"]:not([disabled])',r)||$('textarea',r));if(b)b.focus()}
}
$('#itemList').addEventListener('input',e=>{
  const row=e.target.closest('.it'),f=e.target.dataset.f;if(!row||!f)return;
  const it=app.inv.items.find(x=>x.id===row.dataset.id);if(!it)return;
  it[f]=e.target.value;if(e.target.tagName==='TEXTAREA')autogrow(e.target);
  markEdited();schedule();
});
$('#itemList').addEventListener('click',e=>{
  const b=e.target.closest('[data-act]');if(!b)return;
  const id=b.closest('.it').dataset.id,a=app.inv.items,i=a.findIndex(x=>x.id===id);
  if(b.dataset.act==='del'){
    if(a.length===1)a[0]=item('',1,'');else a.splice(i,1);
    renderItems(a[Math.min(i,a.length-1)].id);
  }else{
    const j=b.dataset.act==='up'?i-1:i+1;if(j<0||j>=a.length)return;
    [a[i],a[j]]=[a[j],a[i]];renderItems(id,b.dataset.act);
  }
  markEdited();schedule();
});
$('#addItem').onclick=()=>{const it=item('',1,'');app.inv.items.push(it);renderItems(it.id);markEdited();schedule()};

function markEdited(){if(app.inv.sample){app.inv.sample=false;$('#sampleNote').hidden=true}}

/* bound fields */
function writeEl(el,v){
  if(el.type==='checkbox')el.checked=!!v;
  else if(el.type==='radio')el.checked=(el.value===v);
  else el.value=v==null?'':v;
}
function fillForm(){$$('[data-bind]').forEach(el=>writeEl(el,getPath(app,el.dataset.bind)))}
const setVal=p=>$$('[data-bind="'+p+'"]').forEach(el=>writeEl(el,getPath(app,p)));
document.addEventListener('input',e=>{
  const el=e.target;if(!el.dataset||!el.dataset.bind)return;
  if(el.type==='radio'&&!el.checked)return;
  const p=el.dataset.bind;
  setPath(app,p,el.type==='checkbox'?el.checked:el.value);
  afterChange(p);
});
function afterChange(p){
  const inv=app.inv;
  if(p.startsWith('inv.'))markEdited();
  if(p==='inv.issue'||p==='inv.terms'){
    if(inv.terms!=='custom'){inv.due=addDays(inv.issue,+inv.terms||0);setVal('inv.due')}
  }
  if(p==='inv.due'&&inv.terms!=='custom'){inv.terms='custom';setVal('inv.terms')}
  if(p==='inv.currency'){setVal('inv.currency');renderItems();}
  if(p==='inv.accent'||p==='inv.layout'||p==='inv.currency')renderDesign();
  if(p.startsWith('xt.')||p==='inv.currency')renderTool();
  schedule();
}

/* ---------- design tab ---------- */
function buildDesign(){
  $('#layGrid').innerHTML=LAYOUTS.map(l=>'<button type="button" class="lay" role="radio" aria-checked="false" data-id="'+l.id+'"><div class="thumb sheet-host"><div class="scaler"></div></div><span>'+l.name+'</span></button>').join('');
  $$('.lay').forEach(b=>mount($('.thumb',b),{noHeight:true}));
  $('#swatches').innerHTML=SWATCHES.map(c=>'<button type="button" class="sw" role="radio" aria-checked="false" data-c="'+c+'" style="background:'+c+'" aria-label="Accent '+c+'" title="'+c+'"></button>').join('');
}
function renderDesign(){
  const inv=app.inv;
  $$('.lay').forEach(b=>b.setAttribute('aria-checked',b.dataset.id===inv.layout));
  $$('.sw').forEach(b=>b.setAttribute('aria-checked',b.dataset.c.toLowerCase()===String(inv.accent).toLowerCase()));
  setVal('inv.accent');
  $('#logoPrev').hidden=!inv.logo;$('#logoRemove').hidden=!inv.logo;
  if(inv.logo)$('#logoPrev').src=inv.logo;
}
function renderThumbs(){
  if(ui.tab!=='design'||document.body.dataset.route!=='invoice')return;
  $$('.lay').forEach(b=>{const h=$('.thumb',b);h.firstElementChild.innerHTML=paperHTML({...app.inv,layout:b.dataset.id,stamp:'none'});fit(h,{noHeight:true})});
}
$('#layGrid').addEventListener('click',e=>{const b=e.target.closest('.lay');if(!b)return;app.inv.layout=b.dataset.id;markEdited();renderDesign();schedule()});
$('#swatches').addEventListener('click',e=>{const b=e.target.closest('.sw');if(!b)return;app.inv.accent=b.dataset.c;markEdited();renderDesign();schedule()});
function shrinkImage(file){
  return new Promise((res,rej)=>{
    const url=URL.createObjectURL(file),img=new Image();
    img.onload=()=>{
      const w0=img.naturalWidth||300,h0=img.naturalHeight||100,k=Math.min(1,360/Math.max(w0,h0));
      const c=document.createElement('canvas');c.width=Math.max(1,Math.round(w0*k));c.height=Math.max(1,Math.round(h0*k));
      c.getContext('2d').drawImage(img,0,0,c.width,c.height);URL.revokeObjectURL(url);
      res(c.toDataURL(/png|svg|gif|webp/.test(file.type)?'image/png':'image/jpeg',.9));
    };
    img.onerror=()=>{URL.revokeObjectURL(url);rej(new Error('bad image'))};
    img.src=url;
  });
}
$('#logoFile').addEventListener('change',async e=>{
  const f=e.target.files&&e.target.files[0];if(!f)return;
  try{app.inv.logo=await shrinkImage(f);markEdited();renderDesign();schedule()}
  catch(err){toast('That image could not be read. Try a PNG or JPG.')}
  e.target.value='';
});
$('#logoRemove').onclick=()=>{app.inv.logo='';renderDesign();schedule()};

/* ---------- tabs ---------- */
const TABS=['details','design','send'];
function setTab(t){
  ui.tab=t;
  TABS.forEach(k=>{
    $('#tab-'+k).hidden=k!==t;
    const b=$('#tabbtn-'+k);b.setAttribute('aria-selected',k===t);b.tabIndex=k===t?0:-1;
  });
  if(t==='design'){renderDesign();renderThumbs()}
  if(t==='send')$('#fileName').textContent='File name: '+fileName();
  if(t==='details')$$('#itemList textarea').forEach(autogrow);
}
TABS.forEach(k=>$('#tabbtn-'+k).addEventListener('click',()=>setTab(k)));
$('.tabs').addEventListener('keydown',e=>{
  if(e.key!=='ArrowRight'&&e.key!=='ArrowLeft')return;
  const i=TABS.indexOf(ui.tab),j=(i+(e.key==='ArrowRight'?1:TABS.length-1))%TABS.length;
  setTab(TABS[j]);$('#tabbtn-'+TABS[j]).focus();e.preventDefault();
});
document.addEventListener('click',e=>{
  const g=e.target.closest('[data-goto]');
  if(g){setTab(g.dataset.goto);window.scrollTo(0,0);return}
  const a=e.target.closest('a[data-tab]');if(a)ui.tab=a.dataset.tab;
});
$$('.mseg button').forEach(b=>b.addEventListener('click',()=>{
  $('#ed').dataset.pane=b.dataset.pane;
  $$('.mseg button').forEach(x=>x.setAttribute('aria-pressed',x===b));
  window.scrollTo(0,0);requestAnimationFrame(()=>{renderPreview();refit()});
}));

/* ---------- send tab ---------- */
const fileName=()=>((app.inv.number||'invoice').replace(/[^\w.-]+/g,'-').replace(/^-+|-+$/g,'')||'invoice')+'.pdf';
function plainText(){
  const s=app.inv,c=calc(s),M=v=>money(v,s.currency),L=[];
  L.push((s.title||'Invoice')+(s.number?' '+s.number:''));
  if(s.from.name)L.push('From: '+s.from.name);
  const to=[s.to.name,s.to.company].filter(Boolean).join(', ');if(to)L.push('To: '+to);
  L.push('Issued: '+fmtDate(s.issue)+'   Due: '+fmtDate(s.due),'');
  c.items.filter(i=>i.desc.trim()||i.amt).forEach(i=>L.push('- '+i.desc.replace(/\s*\n\s*/g,' ')+' ('+numStr(i.q)+' x '+M(i.rateM)+') = '+M(i.amt)));
  L.push('','Subtotal: '+M(c.subtotal));
  if(c.discount)L.push('Discount: -'+M(c.discount));
  if(c.tax)L.push((s.tax.label||'Tax')+(s.tax.inclusive?' (included)':'')+': '+M(c.tax));
  if(c.adj)L.push('Rounding: '+M(c.adj));
  L.push('Total: '+M(c.total));
  if(c.paid>0)L.push('Paid: -'+M(c.paid),'Balance due: '+M(c.due));
  if(s.payment)L.push('','Payment details:',s.payment);
  if(s.notes)L.push('','Notes:',s.notes);
  return L.join('\n');
}
$('#btnCopy').onclick=async()=>{
  const text=plainText();
  try{await navigator.clipboard.writeText(text);toast('Copied the invoice as text.');return}catch(e){}
  try{
    const ta=document.createElement('textarea');ta.value=text;ta.style.cssText='position:fixed;opacity:0';document.body.appendChild(ta);ta.select();
    const ok=document.execCommand('copy');ta.remove();toast(ok?'Copied the invoice as text.':'Copy was blocked. Select the text in the preview instead.');
  }catch(e){toast('Copy was blocked. Select the text in the preview instead.')}
};
if(isFramed)$('#btnPrint').hidden=true;
$('#btnPrint').onclick=()=>{$('#printSheet').innerHTML=paperHTML(app.inv);try{window.print()}catch(e){toast('Printing is blocked here. Use Download PDF instead.')}};

const scriptP={};
function loadScript(src){
  return scriptP[src]||(scriptP[src]=new Promise((res,rej)=>{
    const s=document.createElement('script');s.src=src;s.onload=res;s.onerror=()=>{delete scriptP[src];rej(new Error('Could not load '+src))};document.head.appendChild(s);
  }));
}
async function encodeImage(canvas){
  if(window.CompressionStream){
    const w=canvas.width,h=canvas.height,d=canvas.getContext('2d').getImageData(0,0,w,h).data,rgb=new Uint8Array(w*h*3);
    for(let i=0,j=0;i<d.length;i+=4,j+=3){rgb[j]=d[i];rgb[j+1]=d[i+1];rgb[j+2]=d[i+2]}
    const cs=new CompressionStream('deflate'),wr=cs.writable.getWriter();wr.write(rgb);wr.close();
    return{filter:'FlateDecode',data:new Uint8Array(await new Response(cs.readable).arrayBuffer())};
  }
  const blob=await new Promise(r=>canvas.toBlob(r,'image/jpeg',.95));
  return{filter:'DCTDecode',data:new Uint8Array(await blob.arrayBuffer())};
}
/* Minimal PDF writer: one full-width image per A4 page. */
async function writePdf(pages,title){
  const enc=new TextEncoder(),parts=[],xref=[];let pos=0;
  const put=u=>{const b=typeof u==='string'?enc.encode(u):u;parts.push(b);pos+=b.length};
  const W=595.28,HH=841.89,n=pages.length,total=3*n+4;
  put('%PDF-1.4\n%âãÏÓ\n');
  xref[1]=pos;put('1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n');
  xref[2]=pos;put('2 0 obj\n<< /Type /Pages /Kids ['+pages.map((_,i)=>(4+3*i)+' 0 R').join(' ')+'] /Count '+n+' >>\nendobj\n');
  let hex='FEFF';for(let i=0;i<title.length;i++)hex+=title.charCodeAt(i).toString(16).padStart(4,'0');
  xref[3]=pos;put('3 0 obj\n<< /Title <'+hex+'> /Producer (c.chumi invoice) >>\nendobj\n');
  for(let i=0;i<n;i++){
    const{canvas,hpx,top}=pages[i],po=4+3*i,co=po+1,io=po+2,hpt=hpx*W/794,tpt=top*W/794;
    xref[po]=pos;put(po+' 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 '+W+' '+HH+'] /Resources << /XObject << /Im0 '+io+' 0 R >> >> /Contents '+co+' 0 R >>\nendobj\n');
    const cs='q '+W+' 0 0 '+hpt.toFixed(2)+' 0 '+(HH-tpt-hpt).toFixed(2)+' cm /Im0 Do Q';
    xref[co]=pos;put(co+' 0 obj\n<< /Length '+cs.length+' >>\nstream\n'+cs+'\nendstream\nendobj\n');
    const img=await encodeImage(canvas);
    xref[io]=pos;put(io+' 0 obj\n<< /Type /XObject /Subtype /Image /Width '+canvas.width+' /Height '+canvas.height+' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /'+img.filter+' /Length '+img.data.length+' >>\nstream\n');
    put(img.data);put('\nendstream\nendobj\n');
  }
  const xpos=pos;
  put('xref\n0 '+total+'\n0000000000 65535 f \n');
  for(let k=1;k<total;k++)put(String(xref[k]).padStart(10,'0')+' 00000 n \n');
  put('trailer\n<< /Size '+total+' /Root 1 0 R /Info 3 0 R >>\nstartxref\n'+xpos+'\n%%EOF\n');
  return new Blob(parts,{type:'application/pdf'});
}
async function buildPdf(){
  if(!window.html2canvas)await loadScript(H2C);
  if(document.fonts&&document.fonts.ready)await document.fonts.ready;
  const holder=document.createElement('div');
  holder.style.cssText='position:fixed;left:-10000px;top:0;width:794px;pointer-events:none';
  holder.innerHTML=paperHTML(app.inv);
  const paper=holder.firstElementChild;paper.setAttribute('data-export','');
  document.body.appendChild(holder);
  try{
    const H=paper.offsetHeight,safe=safePoints(paper,1);
    const canvas=await window.html2canvas(paper,{scale:2,backgroundColor:'#ffffff',useCORS:true,logging:false,scrollX:0,scrollY:0});
    const k=canvas.height/H,pages=[];
    planPages(H,safe).forEach(([a,e,top])=>{
      const sub=document.createElement('canvas');sub.width=canvas.width;sub.height=Math.max(1,Math.round((e-a)*k));
      const x=sub.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,sub.width,sub.height);
      x.drawImage(canvas,0,Math.round(a*k),canvas.width,sub.height,0,0,sub.width,sub.height);
      pages.push({canvas:sub,hpx:e-a,top});
    });
    return await writePdf(pages,((app.inv.title||'Invoice')+' '+(app.inv.number||'')).trim());
  }finally{holder.remove()}
}
function saveBlob(blob,name){
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;
  document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),4000);
}
$('#btnPdf').onclick=async()=>{
  const btn=$('#btnPdf'),lab=$('span',btn);
  btn.disabled=true;lab.textContent='Making your PDF…';
  try{
    const blob=await buildPdf(),name=fileName();
    let dl=null;
    try{dl=window.claude&&window.claude.use?await window.claude.use('downloads'):null}catch(e){dl=null}
    if(dl){
      try{await dl.save({filename:name,data:blob});toast('PDF saved as '+name+'.')}
      catch(err){if(!err||err.code!=='declined')toast('The PDF could not be saved here. Try again.')}
    }else{saveBlob(blob,name);toast('Downloaded '+name+'.')}
  }catch(err){
    toast('The PDF tools did not load. Check your connection and try again.');
  }finally{btn.disabled=false;lab.textContent='Download PDF'}
};

/* ---------- new / clear ---------- */
function restore(snap){
  const o=JSON.parse(snap);app.inv=o.inv;app.xt=o.xt;
  fillForm();renderItems();renderToolRows();renderDesign();renderTool();
  $('#sampleNote').hidden=!app.inv.sample;schedule();
}
function replaceInvoice(inv,msg){
  const snap=JSON.stringify(app);
  app.inv=inv;fillForm();renderItems();renderDesign();renderTool();
  $('#sampleNote').hidden=true;schedule();window.scrollTo(0,0);setTab('details');
  toast(msg,{label:'Undo',fn:()=>restore(snap)});
}
$('#clearAll').onclick=()=>replaceInvoice(blankInvoice(null),'Cleared. Fill in your own details.');
$('#btnNew').onclick=()=>{
  const o=app.inv;
  replaceInvoice(blankInvoice(o.sample?null:o),'Started invoice '+(o.sample?'INV-001':bump(o.number))+'.');
};

/* ---------- exact total tool ---------- */
function renderToolRows(focusId){
  const L=$('#xList');
  L.innerHTML=app.xt.rows.map(r=>{
    const id=r.id;
    return'<div class="xr" data-id="'+id+'">'
     +'<div class="xr-d f"><label class="it-lab" for="xd-'+id+'">Description</label><textarea id="xd-'+id+'" rows="1" data-f="desc" autocomplete="off">'+esc(r.desc)+'</textarea></div>'
     +'<div class="xr-s f"><label class="it-lab" for="xs-'+id+'">Share</label><input id="xs-'+id+'" class="num" type="text" inputmode="decimal" data-f="share" value="'+esc(r.share)+'" autocomplete="off"></div>'
     +'<div class="xr-f f"><label class="it-lab" for="xf-'+id+'">Fixed amount</label><input id="xf-'+id+'" class="num" type="text" inputmode="decimal" data-f="fixed" value="'+esc(r.fixed)+'" placeholder="Auto" autocomplete="off"></div>'
     +'<div class="xr-x"><button type="button" class="iconbtn" data-act="del" title="Remove item" aria-label="Remove item"><svg class="ic"><use href="#i-trash"/></svg></button></div></div>';
  }).join('');
  $$('textarea',L).forEach(autogrow);
  if(focusId){const t=$('[data-id="'+focusId+'"] textarea',L);if(t)t.focus()}
}
$('#xList').addEventListener('input',e=>{
  const row=e.target.closest('.xr'),f=e.target.dataset.f;if(!row||!f)return;
  const r=app.xt.rows.find(x=>x.id===row.dataset.id);if(!r)return;
  r[f]=e.target.value;if(e.target.tagName==='TEXTAREA')autogrow(e.target);
  renderTool();schedule();
});
$('#xList').addEventListener('click',e=>{
  const b=e.target.closest('[data-act="del"]');if(!b)return;
  const id=b.closest('.xr').dataset.id;
  app.xt.rows=app.xt.rows.filter(x=>x.id!==id);renderToolRows();renderTool();schedule();
});
$('#xAdd').onclick=()=>{const r={id:uid(),desc:'',share:'1',fixed:''};app.xt.rows.push(r);renderToolRows(r.id);renderTool();schedule()};
let lastX=null;
function renderTool(){
  const el=$('#xResult');if(!el)return;
  const cur=app.inv.currency,M=v=>money(v,cur),r=solveExact(app.xt,cur);lastX=r.err?null:r;
  if(r.err){el.innerHTML='<h3>Your invoice lines</h3><div class="status bad"><svg class="ic"><use href="#i-alert"/></svg><span>'+esc(r.err)+'</span></div>';return}
  const rate=Math.max(num(app.xt.taxRate),0),lbl=esc(app.xt.taxLabel||'Tax')+' ('+numStr(rate)+'%)';
  let msg,cls='ok';
  if(app.xt.mode==='excl')msg='Subtotal '+M(r.S)+' plus '+M(r.tax)+' tax makes '+M(r.total)+'.';
  else if(r.adj===0)msg='These lines add up to exactly '+M(r.target)+'.';
  else{cls='bad';msg='No whole-cent subtotal reaches '+M(r.target)+' exactly at '+numStr(rate)+'% tax, so a rounding line of '+M(r.adj)+' makes up the difference.'}
  el.innerHTML='<h3>Your invoice lines</h3><table class="rt"><tbody>'
    +r.rows.map(x=>'<tr><td>'+esc(x.desc)+'</td><td>'+M(x.amt)+'</td></tr>').join('')
    +'<tr class="sum"><td>Subtotal</td><td>'+M(r.S)+'</td></tr>'
    +(rate>0?'<tr class="sum"><td>'+lbl+'</td><td>'+M(r.tax)+'</td></tr>':'')
    +(r.adj?'<tr class="sum"><td>Rounding</td><td>'+M(r.adj)+'</td></tr>':'')
    +'<tr class="tot"><td>Total</td><td>'+M(r.total)+'</td></tr></tbody></table>'
    +'<div class="status '+cls+'"><svg class="ic"><use href="#'+(cls==='ok'?'i-check':'i-alert')+'"/></svg><span>'+esc(msg)+'</span></div>'
    +'<button class="btn btn-primary btn-block" id="xUse" type="button">Use in invoice →</button>';
}
$('#xResult').addEventListener('click',e=>{
  if(!e.target.closest('#xUse')||!lastX)return;
  const snap=JSON.stringify(app),r=lastX,cur=app.inv.currency,inv=app.inv;
  inv.items=r.rows.map(x=>item(x.desc,1,fromMinor(x.amt,cur)));
  inv.tax={label:app.xt.taxLabel||'Tax',rate:numStr(app.xt.taxRate),inclusive:false};
  inv.discount={type:'percent',value:''};inv.adjustment=r.adj?fromMinor(r.adj,cur):'';inv.sample=false;
  schedule();location.hash='invoice';
  toast('Added '+r.rows.length+(r.rows.length===1?' item':' items')+' to your invoice.',{label:'Undo',fn:()=>restore(snap)});
});

/* ---------- home ---------- */
let homeDone=false;
function renderHome(){
  if(!homeDone){
    homeDone=true;
    const s=sampleState(),hs=$('#heroSheet');
    hs.firstElementChild.innerHTML=paperHTML(s);mount(hs);
    $$('.mini').forEach(h=>{h.firstElementChild.innerHTML=paperHTML({...s,layout:h.dataset.layout});mount(h,{noHeight:true})});
    const c=calc(s),M=v=>money(v,s.currency);
    $('#homeCalc').innerHTML='<div><span>Subtotal</span><span>'+M(c.subtotal)+'</span></div><div><span>Tax (8%)</span><span>'+M(c.tax)+'</span></div><div><span>Total</span><span>'+M(c.total)+'</span></div>';
    const x=solveIncl(500000,5);
    $('#homeX').innerHTML='<span class="cap">Client agreed</span><div class="row big"><span>Total incl. 5% VAT</span><span>'+money(500000,'USD')+'</span></div>'
      +'<span class="cap">The tool finds</span><div class="row"><span>Subtotal</span><span>'+money(x.S,'USD')+'</span></div><div class="row"><span>VAT (5%)</span><span>'+money(x.tax,'USD')+'</span></div><div class="row big"><span>Total</span><span>'+money(x.S+x.tax,'USD')+'</span></div>';
  }
  refit();
}

/* ---------- router ---------- */
function route(){
  const h=location.hash.replace('#',''),r=h==='invoice'?'invoice':h==='exact-total'?'tool':'home';
  document.body.dataset.route=r;
  $$('[data-view]').forEach(v=>{v.hidden=v.dataset.view!==r});
  $$('[data-nav]').forEach(a=>a.setAttribute('aria-current',a.dataset.nav===r?'page':'false'));
  if(r==='home'){
    renderHome();
    const t=h&&document.getElementById(h);
    if(t)t.scrollIntoView();else window.scrollTo(0,0);
  }else{
    window.scrollTo(0,0);
    fillForm();
    if(r==='invoice'){
      $('#sampleNote').hidden=!app.inv.sample;
      setTab(ui.tab);renderItems();renderDesign();renderPreview();renderSummary();
    }else{renderToolRows();renderTool()}
  }
  refit();
}

/* ---------- init ---------- */
function init(){
  load();
  const opts=CURRENCIES.map(([c,n])=>'<option value="'+c+'">'+c+' · '+n+'</option>').join('');
  $('#b-currency').innerHTML=opts;$('#x-cur').innerHTML=opts;
  buildDesign();
  window.addEventListener('hashchange',route);
  route();
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(()=>{refit();if(document.body.dataset.route==='invoice')renderPreview()});
}
init();
//__EXPOSE__
})();
</script>
</body>
</html>
